generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String    @id
  name        String
  email       String    @unique
  password    String
  role        String    @default("user")
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  loginCount  Int       @default(0)

  news News[]

  @@index([role])
}

model News {
  id         String   @id
  title      String
  url        String
  authorId   String?
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model Denuncia {
  id        String   @id
  email     String
  answers   Json
  status    String   @default("new")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
