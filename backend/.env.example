# Copie este ficheiro para .env e ajuste se necessário.
PORT=3001
NODE_ENV=development

# Base de dados MariaDB (mesmo formato da API de referência).
DB_DRIVER="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="aluno"
DB_NAME="backend_db"
DATABASE_URL="mysql://root:aluno@127.0.0.1:3306/backend_db"

# Autenticação JWT
# Gere um segredo próprio com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Administrador criado automaticamente no primeiro arranque.
ADMIN_NAME="Administrador RMVM"
ADMIN_EMAIL="admin@rmvm.com"
ADMIN_PASSWORD="admin123"
